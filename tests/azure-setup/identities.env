# Every identifier the Azure suites and their setup name, in one place.
# `setup.sh` reads this file and fills in an identifier when it creates the
# thing it names; `token.sh` reads the two client identifiers. Nothing here is
# a secret: a tenant, a subscription, an account or an application is
# addressed by these, not opened by them. `docs/AZURE-TESTING.md` says what
# each one is for.

AZURE_TENANT_ID=1caf922b-3c7e-424e-bae2-b8c2d442371d
AZURE_SUBSCRIPTION_ID=f6706ae1-d259-498d-8302-cacf4634d368
AZURE_RESOURCE_GROUP=borink-storage-test
AZURE_LOCATION=westeurope

# The two storage accounts, and the two containers on each: one the live suite
# writes in, one the recorder writes in. `tests/support/src/azure.rs` holds the
# same names, as the endpoints the suites address.
AZURE_FLAT_ACCOUNT=borinkstoragetest
AZURE_HIERARCHICAL_ACCOUNT=borinkstoragehnstest
AZURE_LIVE_CONTAINER=borink-object-test
AZURE_FIXTURES_CONTAINER=borink-object-fixtures

# The repository whose workflow runs the live suite, the environment that
# holds its approval and its variables, and who approves.
GITHUB_REPOSITORY=borink-org/object-storage
GITHUB_ENVIRONMENT=azure-live
GITHUB_REVIEWER=tiptenbrink

# The identity the live suite runs as: the workflow signs in with a federated
# credential, a workstation with a client secret. It writes in the live
# container and reads the whole blob service. `token.sh live` prints a token.
LIVE_APP=borink-object-storage-github-live
LIVE_CLIENT_ID=36916623-6d73-4698-9944-8efcb70537ec
LIVE_OBJECT_ID=bdc02a8f-4712-41fa-8103-69a1a5aaf96b

# The recorder's identity: it writes in the fixtures container and reads the
# whole blob service, and it cannot write in the live container, as the live
# identity cannot write in its. `token.sh fixtures` prints a token.
FIXTURES_APP=borink-object-storage-fixtures
FIXTURES_CLIENT_ID=02bbc639-320f-486b-b329-75fa8ac59b1e
FIXTURES_OBJECT_ID=ec17e818-8f22-4439-b571-b9389ad6db35

# The recorder's second identity, which writes anywhere in the account. It
# records the responses that the container-scoped one is refused before it can
# provoke. `token.sh account` prints a token for it.
FIXTURES_ACCOUNT_APP=borink-object-storage-fixtures-account
FIXTURES_ACCOUNT_CLIENT_ID=4af02271-c5e8-41e3-8d83-1ed20633326a
FIXTURES_ACCOUNT_OBJECT_ID=641336cc-bd00-4355-8544-723b01d31332
